# Managed-services template only. Enter real values privately in each platform.
STAGING=true
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@YOUR_DIRECT_DATABASE_HOST:5432/hotdata_staging?sslmode=require
# Copy to .env; never commit secrets or prefix them with NEXT_PUBLIC_.
# Public origin; production must use HTTPS for secure cookies.
APP_URL=https://YOUR_STAGING_DOMAIN
# Exact comma-separated origins, no credentialed wildcard.
CORS_ALLOWED_ORIGINS=https://YOUR_STAGING_DOMAIN
# Generate separate random URL-safe passwords for local Docker services.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Match the passwords above. Compose overrides hostnames inside the app.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_MANAGED_POOL_HOST:5432/hotdata_staging?sslmode=require&connection_limit=3&pool_timeout=10
REDIS_URL=rediss://USER:PASSWORD@YOUR_MANAGED_REDIS_HOST:6379
# Generate each secret separately with at least 32 random bytes.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=hotdata
JWT_AUDIENCE=hotdata-web
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# AES-256-GCM: base64-encoded 32 random bytes. Back up securely.
PROVIDER_ENCRYPTION_KEY=
# Paystack test credentials locally; switch only after sandbox validation.
PAYMENT_GATEWAY=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack webhook HMAC uses PAYSTACK_SECRET_KEY directly; no separate signing key.
# Future gateway adapters; unavailable until their implementation phase.
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# Resend primary and SMTP fallback; verify the sender domain.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Disabled pluggable messaging hooks.
SMS_PROVIDER=disabled
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Hotdata
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
# Future VTU adapter; admin-managed credentials will be encrypted in PostgreSQL.
VTU_PROVIDER=disabled
VTU_PROVIDER_BASE_URL=
VTU_PROVIDER_API_KEY=
VTU_PROVIDER_USERNAME=
VTU_PROVIDER_PASSWORD=
# Optional monitoring and admin alerts.
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Seed credentials: unique passwords, no published defaults.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
TEST_CUSTOMER_SEED_EMAIL=
TEST_CUSTOMER_SEED_PASSWORD=
TEST_AGENT_SEED_EMAIL=
TEST_AGENT_SEED_PASSWORD=
# Future persisted setting defaults; all money is integer kobo.
FUNDING_MIN_KOBO=10000
FUNDING_MAX_KOBO=100000000
FUNDING_FEE_FLAT_KOBO=0
FUNDING_FEE_BPS=0
REFERRAL_BONUS_KOBO=0
AGENT_UPGRADE_FEE_KOBO=0
WALLET_TRANSFERS_ENABLED=false
MAINTENANCE_MODE=false
# Replace with actual business contacts before publication.
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=
SUPPORT_WHATSAPP=

# Phase 1: independent HMAC secrets (base64-encoded 32 random bytes each).
AUTH_CODE_SECRET=
IP_HASH_SECRET=
# Set true ONLY behind a proxy that overwrites X-Forwarded-For and blocks direct access.
# False uses a shared local bucket, suitable for local development.
TRUST_PROXY=false
# Integration tests require a separate database and explicit opt-in.
RUN_DB_TESTS=false

# Phase 2: bank slug from Paystack supported providers (do not invent one).
PAYSTACK_DVA_BANK=
# Keep proofs outside public/. A durable private volume is required in production.
PRIVATE_UPLOAD_DIR=private-uploads
# Optional manual funding destination; all three fields must be actual business details.
MANUAL_FUNDING_BANK_NAME=
MANUAL_FUNDING_ACCOUNT_NAME=
MANUAL_FUNDING_ACCOUNT_NUMBER=

# Per-tier daily wallet transfer caps in kobo; day boundary is Africa/Lagos.
CUSTOMER_DAILY_TRANSFER_KOBO=100000000
AGENT_DAILY_TRANSFER_KOBO=500000000

# VTU worker limits and operational alerts
PURCHASE_DAILY_LIMIT_KOBO=100000000
PROVIDER_ALERT_EMAIL=

# Customer support links (leave blank until configured)
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# Phase 5 public site. Keep launch/indexing off until reviewed and tested.
PUBLIC_SITE_LIVE=false
PUBLIC_INDEXABLE=false
LEGAL_PUBLISHED=false
# Set verified operator details; no fictitious identity is supplied.
BUSINESS_LEGAL_NAME=
BUSINESS_REGISTRATION_NUMBER=
BUSINESS_ADDRESS=
PRIVACY_EMAIL=
SUPPORT_HOURS=
# Only approved genuine quotes, with permission to publish name/context.
# Example shape: [{"name":"...","quote":"...","context":"..."}]
PUBLIC_TESTIMONIALS_JSON=[]

# Phase 7: exact approved callback DNS hostnames, comma-separated (no wildcard).
# Empty disables callback registration. DNS is checked and pinned on every delivery.
AGENT_CALLBACK_ALLOWED_HOSTS=
# Agent purchases/batches share one Lagos-day spend limit, in integer kobo.
AGENT_PURCHASE_DAILY_LIMIT_KOBO=1000000000
# Agent upgrade fee/enabled flag and referral policy are configured in admin settings.
# IP-restricted keys require TRUST_PROXY=true and a proxy that overwrites the header.

# Vercel: local proof storage is automatically disabled. Keep true on the worker too.
# Private object storage integration is required before enabling manual proof funding.
PROOF_STORAGE_DISABLED=true
